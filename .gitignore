# Preserve only the four regression input CSVs; generated keys/results stay private
/data/generated/*
!/data/generated/clean/
!/data/generated/seed_1/
/data/generated/clean/*
!/data/generated/clean/blotter.csv
!/data/generated/clean/confirmations.csv
/data/generated/seed_1/*
!/data/generated/seed_1/blotter.csv
!/data/generated/seed_1/confirmations.csv

